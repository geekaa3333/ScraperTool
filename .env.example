# Scraper Tool — environment template
#
# Copy to `.env` locally or set these in your host's dashboard.
# THIS FILE CONTAINS NO REAL SECRETS. Never commit a filled-in copy.
#
# Generate real secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ─── Where things live ───────────────────────────────────────────────────────
# Public frontend URL, e.g. https://sellerctrl.netlify.app
# Used for building absolute links in emails (password reset, verification).
PUBLIC_WEB_URL=http://localhost:4310

# Backend origin, e.g. https://api.example.com
# Netlify uses this to proxy /api/*. Users never see it.
BACKEND_URL=http://localhost:4310

# ─── HTTP server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4310
NODE_ENV=production

# ─── Database ────────────────────────────────────────────────────────────────
# Set this to a PostgreSQL connection string to enable accounts, sessions and
# per-user ownership. Leave it as `sqlite` (or unset) for single-operator use,
# which is the tool's original behaviour and needs no database server.
#
# When it is a postgresql:// URL the server switches to multi-user mode:
#   - /api/auth/* becomes available
#   - every other /api route requires a signed-in user
#   - jobs, files and reports are recorded against the owning user
# No credentials belong in frontend JavaScript.
#
# `pglite:<dir>` is also accepted: it runs the same PostgreSQL engine in-process
# against a directory. Useful for local development and for rehearsing the
# migration without provisioning a server.
DATABASE_URL=sqlite

# Pool and query limits for the production driver.
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000

# Path to the SQLite database. Mount /app/data on a persistent volume or
# every redeploy loses job history.
SELLERCTRL_DB=/app/data/sellerctrl.db

# ─── Authentication ──────────────────────────────────────────────────────────
# REQUIRED in production. Rotating this signs every user out; sessions that
# outlive it should be rejected.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-value
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=sellerctrl_session
CSRF_COOKIE_NAME=sellerctrl_csrf
RESET_TTL_SECONDS=1800

# Print password-reset tokens to the server log.
# Leave false in production: it is a development aid, and while it is on the
# reset link is readable from the process log.
EXPOSE_RESET_TOKEN=false

# Set to the public origin(s) allowed to send credentialed requests.
# Must match the Netlify URL exactly, or the browser will refuse the cookie.
CORS_ORIGINS=http://localhost:4310

# Send auth cookies only over HTTPS. Leave true in production.
SECURE_COOKIES=false

# Rate limits (per IP) to blunt credential stuffing.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ─── Object storage (uploaded files + generated reports) ──────────────────────
# Reports must NOT live only on the container filesystem: a redeploy would
# delete them. Any S3-compatible bucket works.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Keep the bucket private; downloads must be served through signed URLs.
S3_FORCE_PATH_STYLE=true

# Where reports live when no S3 bucket is configured. Must NOT be inside the
# directory the web server serves as static files, or reports would become
# publicly readable by URL.
REPORT_STORAGE_DIR=/app/data/reports

# How long generated reports are kept. 0 means keep everything, which is the
# default: a user is expected to be able to re-download a report weeks later.
# Set a positive number only if you genuinely want expiry.
REPORT_RETENTION_DAYS=0

# How long a generated direct-download URL stays valid, in seconds.
SIGNED_URL_TTL_SECONDS=300

# ─── Scraping behaviour ──────────────────────────────────────────────────────
# HARD FLOOR between Amazon requests. Never lower this to "go faster"; it is a
# politeness and account-safety limit, not a tuning knob.
SELLERCTRL_INTERVAL_MS=4000
SELLERCTRL_MAX_EXTRA_INTERVAL_MS=3000

# Pause this long when Amazon returns CAPTCHA / 403 / 429 / 503.
SELLERCTRL_COOLDOWN_MS=600000

# Per-navigation timeout.
AMAZON_TIMEOUT_MS=45000

# How long to wait for a page's required selectors before capturing anyway.
SELLERCTRL_READY_TIMEOUT_MS=15000

# Cache lifetime for a stored snapshot. 0 disables cache reads (always live).
SELLERCTRL_CACHE_TTL=900

# Maximum ASIN rows in one batch.
SELLERCTRL_MAX_ASINS_PER_JOB=10000

# Grace period for clean shutdown on SIGTERM during a deploy.
SHUTDOWN_TIMEOUT_MS=30000

# ─── Worker ──────────────────────────────────────────────────────────────────
# How often a worker checks for claimable items.
WORKER_POLL_INTERVAL_MS=2000

# Lease length. A crashed worker's items become reclaimable after this.
WORKER_LEASE_MS=120000

# Grace period a job waits for an in-flight item before being retried.
WORKER_GRACE_MS=30000